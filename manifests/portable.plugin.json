{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "testsy",
  "version": "1.1.1",
  "description": "Check releases, investigate failed runs and save regression tests with Testsy.",
  "author": {
    "name": "Testsy",
    "email": "contact@testsy.dev",
    "url": "https://testsy.dev"
  },
  "homepage": "https://testsy.dev/docs/mcp/",
  "license": "MIT",
  "keywords": [
    "testing",
    "qa",
    "regression",
    "release",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Testsy",
        "shortDescription": "Check your app and inspect the evidence",
        "longDescription": "Check releases, investigate failed runs and save regression tests with Testsy.",
        "developerName": "Testsy",
        "category": "Developer Tools",
        "websiteURL": "https://testsy.dev",
        "privacyPolicyURL": "https://testsy.dev/privacy",
        "termsOfServiceURL": "https://testsy.dev/terms",
        "supportURL": "https://testsy.dev/docs/",
        "defaultPrompt": [
          "Check my release with Testsy.",
          "Investigate this failed Testsy run.",
          "Turn this bug into a Testsy regression test."
        ]
      }
    }
  }
}
